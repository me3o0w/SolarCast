# Copy to .streamlit/secrets.toml and fill in your project values.
[supabase]
url = "https://ypwcuspzylvrefurponv.supabase.co"
publishable_key = "YOUR_SUPABASE_PUBLISHABLE_KEY"
# Optional server-only key for shared archive maintenance.
# secret_key = "YOUR_SUPABASE_SERVER_SECRET_KEY"
# Set this to the deployed HTTPS URL when hosting SolarCast.
# auth_redirect_url = "https://your-solarcast.example"
# Enable only after saving the code-only Reset password template in Supabase.
password_recovery_codes_enabled = false
